# Backend auth environment variables for local development
# Copy this to .env and fill in real values

APP_ENV=local

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/creditpaper

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@creditpaper.com

# Supabase OAuth policy (configure matching providers in Supabase Dashboard)
# Azure provider: use a Single Tenant app and set its Directory (tenant) ID here.
SUPABASE_MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Legacy server-side OAuth settings (unused by the active Supabase flow)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Session and OAuth cookies are HTTPS-only when true. Set true in every deployed environment;
# false only for local http development.
COOKIE_SECURE=false

# Supabase Admin API — enables the signup guard to see users registered in
# Supabase Auth (exact duplicate-email detection and domain-user checks).
# Without these, those checks degrade to tenant-row lookups only; the app
# still runs. Get both values from Supabase Dashboard > Settings > API.
# NEVER expose the service-role key to the frontend or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM Encryption
ENCRYPTION_KEY=your-base64-encoded-key

# LLM provider: nvidia, anthropic, ollama, google (legacy openrouter remains supported)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Required exact hosted model IDs. No NVIDIA model names are built into code.
LLM_EXTRACT_MODEL=
LLM_PROSE_MODEL=
# NVIDIA requests use no automatic retries; failed extraction follows the existing hold path.
NVIDIA_TIMEOUT_S=120
# Optional for models supporting chat_template_kwargs.enable_thinking.
# Set false for concise extraction; leave blank for provider defaults or unsupported models.
NVIDIA_ENABLE_THINKING=
# Local/test Gemini Developer API. Never commit a real key.
GOOGLE_API_KEY=
# Explicit local-only opt-in; generation otherwise remains pinned to Anthropic.
GOOGLE_GENERATION_ENABLED=false
LLM_PROVIDER_TIMEOUT_S=120
OCR_DPI=120
OCR_TIMEOUT_S=5
OCR_DESKEW=false
OCR_MAX_PAGES_PER_DOCUMENT=100
PDF_EXTRACT_PROCESSES=4
PDF_EXTRACT_TIMEOUT_S=120
PDF_OCR_WORKERS=3
# Process-wide hosted concurrency limit (also applies to existing providers).
ANTHROPIC_MAX_CONCURRENCY=8
# Local testing: set LLM_PROVIDER=ollama and the LLM_*_MODEL values to installed local IDs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=600
OLLAMA_FACTS_TIMEOUT_S=300
OLLAMA_GENERATION_TIMEOUT_S=600
# Optional cache namespace for controlled cold/warm benchmark pairs.
PROCESSING_CACHE_NAMESPACE=
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=auto
OLLAMA_TEXT_CONTEXT_CHARS=48000
# Comma-separated exact model names for locally installed vision models.
OLLAMA_VISION_MODELS=
# Local/test only: exercise the complete credit-paper generation flow via Ollama.
OLLAMA_GENERATION_ENABLED=false

# Billing (flow C). Leave blank to run without card payments: Settings, Billing still shows
# plan and usage, and says cards are not connected. Placeholders only; real keys live in .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
# Document jobs run in a separate process by default. Start with:
# uv run python scripts/process_jobs.py --all-tenants --concurrency 4 --per-tenant 2
# 'inline' is a legacy local/test-only opt-in, not recommended for folder imports.
PROCESSING_WORKER_MODE=external
# Local-first broker. Set `database` only while rolling back to the legacy
# PostgreSQL polling worker. Redis is never the workflow source of truth.
PROCESSING_QUEUE_BACKEND=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# At most this many tasks from one tenant execute in each worker fleet.
CELERY_TENANT_CONCURRENCY=4
# Leave unset to use adaptive defaults: parse=(tenant ceiling - 1), other lanes=1.
CELERY_TENANT_QUEUE_CONCURRENCY=
CELERY_DISPATCH_PER_TENANT_QUEUE=
CELERY_DELIVERY_DEDUPE_SECONDS=120
# Expired semaphore members are pruned after this interval. A renewal thread
# keeps live tasks present; a crashed worker cannot permanently consume a slot.
CELERY_TENANT_LEASE_S=120
# Keep local Ollama independently bounded across all Celery worker processes.
CELERY_LLM_CONCURRENCY=1
# Phase 1 includes the ZIP coordinator and final matching around parse/OCR.
CELERY_MIGRATED_KINDS=archive_import,parse,parse_ocr,archive_match
# Keep API and worker connection pools within Supabase's session-mode limit.
# Recommended deployment budgets: API=7, three lane workers x 2 connections.
CREDITPAPER_DB_POOL_MAX=7
# Worker pool is budgeted separately from the API pool (Supabase cap: 15).
CREDITPAPER_WORKER_DB_POOL_MAX=2
# Total supervised worker processes across all lanes.
CREDITPAPER_WORKER_REPLICAS=3
CREDITPAPER_DB_POOL_TIMEOUT=4
EXTRACTION_FINALIZE_BATCH=8
EXTRACTION_FINALIZE_WINDOW_MS=2500
# Set by the process supervisor. API processes use "api"; job workers use "worker".
CREDITPAPER_PROCESS_ROLE=api
# New migrations own their grants; set to 0 in controlled deployments to skip
# the legacy repository-wide post-migration grant sweep.
CREDITPAPER_ALEMBIC_GRANT_SWEEP=1
# Fail worker startup rather than silently oversubscribing a production host.
CREDITPAPER_WORKER_MAX_CONCURRENCY=8
# OCR is nested inside document workers; keep this bounded to avoid thread storms.
OCR_WORKERS=4
