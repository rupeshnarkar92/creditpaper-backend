.superpowers/
.worktrees/

# Legal instruments (NDAs, agreements, the D12 boundary paper). Kept local:
# these are executed/draft legal documents, not source, and they must never be
# published to the remote by an accidental `git add -A`.
credit paper legals/

# Scratch debug output from doc-consistency checks — not an artefact of the build.
check_out.txt

# Agent tooling. Project-level .claude/settings.json IS shared and committed;
# per-developer overrides are not. Previously this was only covered by one
# machine's global gitignore, so a new clone would have committed it.
.claude/settings.local.json

# Type-checker cache
.mypy_cache/

# Node (apps/credit-web has its own .gitignore; this is the belt-and-braces
# rule so a stray install at the repo root can't be committed)
node_modules/

