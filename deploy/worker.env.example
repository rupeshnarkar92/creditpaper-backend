# Install as /etc/creditpaper/worker.env with mode 0600. Secrets belong in the
# deployment secret manager; this file documents only worker-specific controls.
APP_ENV=production
PROCESSING_WORKER_MODE=external
CREDITPAPER_PROCESS_ROLE=worker
CREDITPAPER_DB_POOL_MAX=7
CREDITPAPER_WORKER_DB_POOL_MAX=2
CREDITPAPER_WORKER_REPLICAS=3
CREDITPAPER_DB_POOL_TIMEOUT=4
PDF_EXTRACT_PROCESSES=4
PDF_EXTRACT_TIMEOUT_S=120
OCR_WORKERS=4
OCR_TIMEOUT_S=5
OCR_MAX_PAGES_PER_DOCUMENT=100
EXTRACTION_FINALIZE_BATCH=8
EXTRACTION_FINALIZE_WINDOW_MS=1500
PROCESSING_CLAIM_BATCH=8
PROCESSING_FINISH_BATCH=8
PROCESSING_FINISH_WINDOW_MS=500
OMP_THREAD_LIMIT=1
